{
  "name": "gyusik-desktop",
  "productName": "규식이",
  "version": "0.1.0",
  "description": "규식이: 한국어로 정규식을 배우고, 만들고, 테스트하는 도구 (Windows 설치형)",
  "main": "main.js",
  "author": "sinsan-develop",
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "prepare-site": "node scripts/prepare-site.cjs",
    "start": "npm run prepare-site && electron .",
    "smoke": "npm run prepare-site && electron . --smoke",
    "dist": "npm run prepare-site && electron-builder --win --x64 --arm64"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "kr.sinsan.gyusik",
    "productName": "규식이",
    "copyright": "Based on RegExr, Copyright (C) 2017 gskinner.com, inc. GPL-3.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "policy.js",
      "package.json",
      "site/**/*"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE.md",
        "to": "NOTICE.md"
      },
      {
        "from": "SOURCE.txt",
        "to": "SOURCE.txt"
      },
      {
        "from": "policy.example.json",
        "to": "policy.example.json"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "Gyusik-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "language": "1042"
    }
  }
}
